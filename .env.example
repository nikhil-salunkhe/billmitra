# BillMitra Backend — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env or real secrets to version control.

NODE_ENV=production
PORT=5000

# --- Database (MongoDB Atlas) ---
MONGODB_URI=

# --- Auth ---
JWT_SECRET=

# --- CORS / Allowed Origins ---
CLIENT_URL=https://billmitraadmin.netlify.app

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Optional: extra allowed origins (comma-separated) ---
# CORS_ORIGINS=https://billmitraadmin.netlify.app
# ADMIN_URL=https://billmitraadmin.netlify.app
# OWNER_APP_URL=

# --- Optional: image storage (local is ephemeral on Render) ---
# STORAGE_PROVIDER=local
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Optional: admin seed (initial setup only) ---
# ADMIN_SEED_EMAIL=
# ADMIN_SEED_NAME=Super Admin
# ADMIN_SEED_PASSWORD=

